{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secure Verified Exchange",
  "mainBinaryName": "svx-desktop",
  "version": "0.1.0",
  "identifier": "org.svx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Secure Verified Exchange",
        "width": 980,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Seal files so only the right person can open them",
    "longDescription": "Seal files and folders into signed, encrypted .svx files that only the people you choose can open, and open .svx files you receive. You stay in control after sending: approval, one-time opening, expiry and revocation.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "svx"
        ],
        "name": "SVX sealed file",
        "description": "SVX sealed file",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.svx",
        "exportedType": {
          "identifier": "org.svx.artifact",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/svx-file.icns": "icons/svx-file.icns"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/svx-desktop.xml": "../../../packaging/linux/svx-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-16.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-vnd.svx.png": "../../../packaging/linux/icons/application-vnd.svx-512.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.svx.svg": "../../../packaging/linux/icons/application-vnd.svx.svg"
        }
      }
    }
  }
}
