<!-- Merge into the Info.plist of the SVX app bundle (Phase 5). -->
<key>UTExportedTypeDeclarations</key>
<array>
  <dict>
    <key>UTTypeIdentifier</key><string>org.svx.artifact</string>
    <key>UTTypeDescription</key><string>SVX secure exchange artifact</string>
    <key>UTTypeConformsTo</key><array><string>public.data</string></array>
    <key>UTTypeTagSpecification</key>
    <dict>
      <key>public.filename-extension</key><array><string>svx</string></array>
      <key>public.mime-type</key><array><string>application/vnd.svx</string></array>
    </dict>
  </dict>
</array>
<key>CFBundleDocumentTypes</key>
<array>
  <dict>
    <key>CFBundleTypeName</key><string>SVX artifact</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>LSHandlerRank</key><string>Owner</string>
    <key>LSItemContentTypes</key><array><string>org.svx.artifact</string></array>
  </dict>
</array>
